<Window x:Class="KioskSkytel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#009EFA">

    <Grid>

        <!-- HEADER -->
        <TextBlock Text="SKYTEL"
                   Foreground="White"
                   FontSize="42"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,30,0,0"/>

        <!-- MAIN GRID -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- CARD 1 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">
                <Grid Margin="20">

                    <StackPanel>
                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12"
                                HorizontalAlignment="Left">

                            <!-- ICON PLACEHOLDER -->
                            <TextBlock Text="📄"
                                       FontSize="26"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Шинэ дугаар"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Үрчилсэн болон дараа төлбөрт үйлчилгээний шинэ дугаар"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Button Content="→"
                                Width="50"
                                Height="35"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- CARD 2 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">
                <Grid Margin="20">

                    <StackPanel>
                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12">

                            <TextBlock Text="⚡"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Нэгж авах"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Үрчилсэн төлбөрт үйлчилгээний цэнэглэгч картууд"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Button Content="→"
                                Width="50"
                                Height="35"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- CARD 3 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">

                <Grid Margin="20">
                    <StackPanel>

                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12">
                            <TextBlock Text="💳"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Төлбөр төлөх"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Хүссэн газраасаа, хүссэн цагтаа төлбөрөө төлөх боломж"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Button Content="→"
                                Width="50"
                                Height="35"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 4 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">

                <Grid Margin="20">
                    <StackPanel>

                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12">
                            <TextBlock Text="🔄"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Сим сэргэх"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Та GoSIM ашиглан хүссэн үедээ симээ сэргээж"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <Button Content="→"
                                Width="50"
                                Height="35"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0"/>

                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>