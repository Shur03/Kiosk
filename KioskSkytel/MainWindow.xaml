<Window x:Class="KioskSkytel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="KioskApp.UI/Assets/mongoldoo.png"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="187*"/>
            <ColumnDefinition Width="183*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- Overlay -->
        <Rectangle Fill="#009EFA"
                   Opacity="0.75" Grid.ColumnSpan="3" Margin="0,0,1,0"/>

        <!-- MAIN LAYOUT -->
        <Grid Grid.ColumnSpan="3" Margin="0,0,1,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT MENU -->
            <Border Grid.Column="0"
                    Background="#0F172A"
                    Opacity="0.96">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="40">

                        <!-- TITLE -->
                        <TextBlock Text="SKYTEL"
                                   Foreground="White"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Margin="0,20,0,40"/>

                        <!-- MENU BUTTON -->
                        <Button Margin="0,0,0,16"
                                Background="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Height="90">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border CornerRadius="18"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                            <Grid Margin="20,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10">

                                    <TextBlock Text="📄"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">

                                    <TextBlock Text="Skytel"
                                               FontSize="17"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Үйлчилгээ авах"
                                               FontSize="12"
                                               Foreground="Gray"/>

                                </StackPanel>

                            </Grid>

                        </Button>
                        <Button Margin="0,0,0,16"
                                Background="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Height="90">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border CornerRadius="18"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                            <Grid Margin="20,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10">

                                    <TextBlock Text="📄"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">

                                    <TextBlock Text="Skytel"
                                               FontSize="17"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Үйлчилгээ авах"
                                               FontSize="12"
                                               Foreground="Gray"/>

                                </StackPanel>

                            </Grid>

                        </Button>
                        <Button Margin="0,0,0,16"
                                Background="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Height="90">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border CornerRadius="18"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                            <Grid Margin="20,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10">

                                    <TextBlock Text="📄"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">

                                    <TextBlock Text="Skytel"
                                               FontSize="17"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Үйлчилгээ авах"
                                               FontSize="12"
                                               Foreground="Gray"/>

                                </StackPanel>

                            </Grid>

                        </Button>
                        <Button Margin="0,0,0,16"
                                Background="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Height="90">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border CornerRadius="18"
                                            Background="{TemplateBinding Background}">

                                        <ContentPresenter/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                            <Grid Margin="20,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10">

                                    <TextBlock Text="📄"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">

                                    <TextBlock Text="Skytel"
                                               FontSize="17"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="Үйлчилгээ авах"
                                               FontSize="12"
                                               Foreground="Gray"/>

                                </StackPanel>

                            </Grid>

                        </Button>

                        <!-- MORE BUTTONS HERE -->

                    </StackPanel>

                </ScrollViewer>

            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1">

                <ContentControl x:Name="MainContent"/>

                <!-- TEMP PLACEHOLDER -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="WELCOME"
                               FontSize="52"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <!-- <TextBlock Text="Select a service from the left menu"
                               FontSize="20"
                               Foreground="White"
                               Opacity="0.8"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/> -->

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>