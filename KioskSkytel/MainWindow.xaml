<Window x:Class="KioskSkytel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Stylus.IsPressAndHoldEnabled="False">

    <Window.Resources>
        <!-- Reusable menu button style - no radius, full height -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#F0F9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/KioskApp.UI/Assets/images/mongoldoo.png"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <!-- Dark overlay -->
        <Rectangle Fill="#009EFA" Opacity="0.75"/>

        <!-- MAIN LAYOUT: Left menu + Right content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT MENU - Full height, no gaps -->
            <Border Grid.Column="0"
                    Background="#0F172A"
                    Opacity="0.96">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalFirst"
                              Background="White">
                    <StackPanel Margin="0">
                        <!-- SKYTEL -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSkytel_Click"
                                >
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                    <Image Source="/KioskApp.UI/Assets/images/favicon.ico"
                                           Width="28"
                                           Height="28"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="SKYTEL"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="Black"
                                           Margin="0,8,0,16"/>
                            </Grid>
                        </Button>

                        <!-- SKYMEDIA -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSkymedia_Click">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                    <Image Source="/KioskApp.UI/Assets/images/favicon.ico"
                                           Width="28"
                                           Height="28"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="SKYMEDIA"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="Black"
                                           Margin="0,8,0,16"/>
                            </Grid>
                        </Button>

                        <!-- GO+ -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnGoPlus_Click">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                    <Image Source="/KioskApp.UI/Assets/images/favicon.ico"
                                           Width="28"
                                           Height="28"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="GO+"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="Black"
                                           Margin="0,8,0,16"/>
                            </Grid>
                        </Button>

                        <!-- SKYNET -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSkynet_Click">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                    <Image Source="/KioskApp.UI/Assets/images/favicon.ico"
                                           Width="28"
                                           Height="28"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="SKYNET"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="Black"
                                           Margin="0,8,0,16"/>
                            </Grid>
                        </Button>

                        <!-- CALLY -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnCally_Click">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Width="44" Height="44"
                                        Background="Transparent"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                    <Image Source="/KioskApp.UI/Assets/images/favicon.ico"
                                           Width="28"
                                           Height="28"
                                           Stretch="Uniform"/>
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Text="CALLY"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="Black"
                                           Margin="0,8,0,16"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <ContentControl x:Name="MainContent"
                            Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>