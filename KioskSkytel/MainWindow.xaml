<Window x:Class="KioskSkytel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Stylus.IsPressAndHoldEnabled="False">

    <Window.Resources>
        <!-- Reusable menu button style -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#F0F9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- Background image -->

        <!-- Dark overlay -->
        <Rectangle Fill="#009EFA" Opacity="0.75"/>

        <!-- MAIN LAYOUT: Left menu + Right content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================= -->
            <!-- LEFT MENU                 -->
            <!-- ========================= -->
            <Border Grid.Column="0"
                    Background="#0F172A"
                    Opacity="0.96">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalFirst">
                    <StackPanel Margin="20,30,20,30">

                        <!-- LOGO -->
                        <TextBlock Text="SKYTEL"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="8,0,0,32"/>

                        <!-- SKYTEL -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSkytel_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Skytel"
                                               FontSize="17"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Үйлчилгээ авах"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- SKYMEDIA -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSkymedia_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Skymedia"
                                               FontSize="17"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Медиа үйлчилгээ"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- GO+ -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnGoPlus_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="💳" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="GO+"
                                               FontSize="17"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="GO+ үйлчилгээ"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- SKYNET -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnSkynet_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Skynet"
                                               FontSize="17"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Интернет үйлчилгээ"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- CALLY -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnCally_Click">
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        Background="#F1F5F9"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="📞" FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="Cally"
                                               FontSize="17"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Дуудлагын үйлчилгээ"
                                               FontSize="12"
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================= -->
            <!-- RIGHT CONTENT AREA        -->
            <!-- ========================= -->
            <ContentControl x:Name="MainContent"
                            Grid.Column="1"/>

        </Grid>
    </Grid>
</Window>
