<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="KioskApp.Core\**" />
    <Compile Remove="KioskApp.Shared\**" />
    <Compile Remove="KioskApp.UI\Controls\**" />
    <EmbeddedResource Remove="KioskApp.Core\**" />
    <EmbeddedResource Remove="KioskApp.Shared\**" />
    <EmbeddedResource Remove="KioskApp.UI\Controls\**" />
    <None Remove="KioskApp.Core\**" />
    <None Remove="KioskApp.Shared\**" />
    <None Remove="KioskApp.UI\Controls\**" />
    <Page Remove="KioskApp.Core\**" />
    <Page Remove="KioskApp.Shared\**" />
    <Page Remove="KioskApp.UI\Controls\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="KioskApp.UI\Assets\images\favicon.ico" />
    <None Remove="KioskApp.UI\Assets\images\lottery.jpg" />
    <None Remove="KioskApp.UI\Assets\images\mongoldoo.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="KioskApp.Services\Api\" />
    <Folder Include="KioskApp.Services\DTOs\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="KioskApp.UI\Assets\images\favicon.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="KioskApp.UI\Assets\images\lottery.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="KioskApp.UI\Assets\images\mongoldoo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <CardReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <CardReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="PCSC" Version="7.0.1" />
    <PackageReference Include="PCSC.Iso7816" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="KioskApp.UI\Views\AccountPaymentInfo.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="KioskApp.UI\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
