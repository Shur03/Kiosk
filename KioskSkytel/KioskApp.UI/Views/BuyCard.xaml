<Window x:Class="KioskSkytel.KioskApp.UI.Views.BuyCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BuyCard"
        Height="600"
        Width="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Card style -->
        <Style x:Key="CardCard"
               TargetType="Border">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="CornerRadius"
                    Value="16"/> 
            <Setter Property="Padding"
                    Value="20,0,20,18"/>
            <Setter Property="Margin"
                    Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.07"
                                      BlurRadius="18"
                                      ShadowDepth="2"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "Авах" button style -->
        <Style x:Key="BuyButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#111111"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1.5"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#F0FDFB"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#00BFA5"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#E0F7F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <DockPanel LastChildFill="True"
                   VerticalAlignment="Top"
                   Height="64"
                   Background="White">
            <DockPanel.Effect>
                <DropShadowEffect Color="#000000"
                                  Opacity="0.06"
                                  BlurRadius="10"
                                  ShadowDepth="2"
                                  Direction="270"/>
            </DockPanel.Effect>
            <TextBlock Text="Нэгж сонгох"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111111"
                       VerticalAlignment="Center"
                       Margin="32,0,0,0"
                       DockPanel.Dock="Left"/>
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Margin="0,0,24,0"
                    Width="36"
                    Height="36"
                    FontSize="16"
                    Foreground="#888888"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding CloseCommand}"/>
        </DockPanel>

        <!-- Scrollable card grid -->
        <ScrollViewer Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      Padding="0,20,0,0">

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardCard}"
                                Height="200">
                            <StackPanel>
                                <TextBlock Text="{Binding Price, StringFormat={}{0} ₮}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="DimGray"/>
                                <TextBlock Text="{Binding DataGB,StringFormat={}{0} GB дата}"
                                           FontSize="13"
                                           Foreground="DimGray"
                                           Margin="0,2,0,0"/>
                                <Separator Background="#EEEEEE"
                                           Margin="0,14,0,0"
                                           Height="1"/>
                                <TextBlock Text="{Binding UnitAmount}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#111111"/>
                                <TextBlock Text="{Binding Duration}"
                                           FontSize="13"
                                           Foreground="#888888"
                                           Margin="0,3,0,0"/>
                                <Button Content="Сонгох"
                                        Style="{StaticResource BuyButton}"
                                        Command="{Binding BuyCommand}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
