<UserControl x:Class="KioskSkytel.KioskApp.UI.Views.SkyMedia.SkyMedia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#F0F4F8">

    <UserControl.Resources>
        <Style x:Key="CardButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="1.5"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="24,32,24,32">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000"
                                                  Opacity="0.08"
                                                  BlurRadius="20"
                                                  ShadowDepth="3"
                                                  Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#E2E8F0"/>
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#FAFCFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="CardGrid"
              Margin="20"
              SizeChanged="CardGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шинэ захиалга -->
            <Button Grid.Column="0"
                    Style="{StaticResource CardButtonStyle}"
                    Click="BtnBuyCard_Click">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="160">

                    <!-- Icon circle -->
                    <Border Width="72"
                            Height="72"
                            CornerRadius="36"
                            Background="#EEF4FF"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <MaterialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Width="36"
                                Height="36"
                                                 Foreground="#1A73E8"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Шинэ захиалга"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                </StackPanel>
            </Button>

            <!-- Хаяг шилжих захиалга -->
            <Button Grid.Column="1"
                    Style="{StaticResource CardButtonStyle}"
                    Click="BtnChangeAddress_Click">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Width="160">

                    <!-- Icon circle -->
                    <Border Width="72"
                            Height="72"
                            CornerRadius="36"
                            Background="#FFF7E6"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <MaterialDesign:PackIcon Kind="FileDocumentOutline"
                                                 Width="36"
                                Height="36"
                                                 Foreground="#1A73E8"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Хаяг шилжих захиалга"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1A1A2E"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Button>

        </Grid>
    </ScrollViewer>
</UserControl>
