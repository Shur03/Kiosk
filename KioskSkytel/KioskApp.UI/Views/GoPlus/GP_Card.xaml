<Window x:Class="KioskSkytel.KioskApp.UI.Views.GoPlus.GP_Card"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title=""
        Height="520"
        Width="860"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <!-- Close circle button -->
        <Style x:Key="CloseButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="44"/>
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="White"
                                CornerRadius="22"
                                BorderBrush="#1565C0"
                                BorderThickness="2">
                            <TextBlock Text="✕"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- СОНГОХ button (inside card) -->
        <Style x:Key="SelectButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#1565C0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Continue pill button -->
        <Style x:Key="ContinueButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="52"/>
            <Setter Property="MinWidth"
                    Value="220"/>
            <Setter Property="FontSize"
                    Value="18"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#1565C0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card item DataTemplate -->
        <DataTemplate x:Key="CardItemTemplate">
            <Border x:Name="CardBorder"
                    Background="White"
                    CornerRadius="16"
                    BorderBrush="#CBD5E1"
                    BorderThickness="2"
                    Margin="8"
                    Padding="20,18"
                    Width="180"
                    Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="2"
                                      Opacity="0.08"
                                      Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Card name -->
                    <TextBlock Text="{Binding Name}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#0D1B2A"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <!-- Хоног -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <TextBlock Text="{Binding Days}"
                                   FontSize="14"
                                   Foreground="#475569"/>
                        <TextBlock Text=" хоног"
                                   FontSize="14"
                                   Foreground="#475569"/>
                    </StackPanel>

                    <!-- Нэгж -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <TextBlock Text="{Binding Units}"
                                   FontSize="14"
                                   Foreground="#475569"/>
                        <TextBlock Text=" нэгж"
                                   FontSize="14"
                                   Foreground="#475569"/>
                    </StackPanel>

                    <!-- Price -->
                    <TextBlock Text="{Binding PriceFormatted}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#1565C0"
                               Margin="0,0,0,14"/>

                    <!-- СОНГОХ button -->
                    <Button Content="СОНГОХ"
                            Style="{StaticResource SelectButtonStyle}"
                            Command="{Binding DataContext.SelectCardCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>

                <!-- Selected highlight trigger -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}"
                                         Value="True">
                                <Setter Property="BorderBrush"
                                        Value="#1565C0"/>
                                <Setter Property="BorderThickness"
                                        Value="2.5"/>
                                <Setter Property="Background"
                                        Value="#F0F7FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <!-- Outer shadow card -->
    <Border Background="White"
            CornerRadius="24"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40"
                              ShadowDepth="8"
                              Opacity="0.15"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Cards area -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── HEADER ── -->
            <Grid Grid.Row="0"
                  Margin="28,22,20,0">
                <TextBlock Text="Картын сонголт"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0D1B2A"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CancelBtn_Click"/>
            </Grid>

            <!-- Divider -->
            <Rectangle Grid.Row="0"
                       Height="1"
                       Fill="#E2E8F0"
                       VerticalAlignment="Bottom"
                       Margin="0,58,0,0"/>

            <!-- ── CARDS AREA ── -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="20,16,20,0">
                <ItemsControl ItemsSource="{Binding Cards}"
                              ItemTemplate="{StaticResource CardItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── FOOTER ── -->
            <Border Grid.Row="2"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="28,16,28,20">
                <Grid>
                    <!-- Selected card summary (left) -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Сонгосон: "
                                   FontSize="15"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedCard.Name, FallbackValue='—'}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#0D1B2A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Continue button (right) -->
                    <Button Style="{StaticResource ContinueButtonStyle}"
                            HorizontalAlignment="Right"
                            Command="{Binding ContinueCommand}"
                            Padding="28,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Үргэлжлүүлэх  ›"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
