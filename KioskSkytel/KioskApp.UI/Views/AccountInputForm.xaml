<Window x:Class="KioskSkytel.KioskApp.UI.Views.AccountInputForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:KioskSkytel.KioskApp.UI.Converters"
        mc:Ignorable="d"
        Title=""
        Height="700"
        Width="550"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        AllowsTransparency="True"
        Background="Transparent">

        <Window.Resources>
                <!-- Converters -->
                <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

                <!-- Drop Shadow Effect -->
                <DropShadowEffect x:Key="WindowShadow"
                                  BlurRadius="25"
                                  ShadowDepth="0"
                                  Color="#000000"
                                  Opacity="0.25"/>

                <DropShadowEffect x:Key="ButtonShadow"
                                  BlurRadius="8"
                                  ShadowDepth="2"
                                  Color="#000000"
                                  Opacity="0.15"/>

                <Style x:Key="NumPadButtonStyle"
                       TargetType="Button">
                        <Setter Property="FontSize"
                                Value="28"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#1E293B"/>
                        <Setter Property="Background"
                                Value="#FFFFFF"/>
                        <Setter Property="Margin"
                                Value="6"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Height"
                                Value="70"/>
                        <Setter Property="Effect"
                                Value="{StaticResource ButtonShadow}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="16"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#F1F5F9"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#3B82F6"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderThickness"
                                                                        Value="2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#E2E8F0"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="RenderTransform">
                                                                        <Setter.Value>
                                                                                <ScaleTransform ScaleX="0.97"
                                                                                                ScaleY="0.97"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="ClearButtonStyle"
                       TargetType="Button">
                        <Setter Property="FontSize"
                                Value="28"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#EF4444"/>
                        <Setter Property="Background"
                                Value="#FEF2F2"/>
                        <Setter Property="Margin"
                                Value="6"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Height"
                                Value="70"/>
                        <Setter Property="Effect"
                                Value="{StaticResource ButtonShadow}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="16"
                                                        BorderBrush="#FEE2E2"
                                                        BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#FEE2E2"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderBrush"
                                                                        Value="#EF4444"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="BorderThickness"
                                                                        Value="2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#FECACA"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="RenderTransform">
                                                                        <Setter.Value>
                                                                                <ScaleTransform ScaleX="0.97"
                                                                                                ScaleY="0.97"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="OkButtonStyle"
                       TargetType="Button">
                        <Setter Property="FontSize"
                                Value="28"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="Background"
                                Value="#2563EB"/>
                        <Setter Property="Margin"
                                Value="6"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Height"
                                Value="70"/>
                        <Setter Property="Effect"
                                Value="{StaticResource ButtonShadow}"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="16"
                                                        BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#3B82F6"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter TargetName="Bd"
                                                                        Property="Background"
                                                                        Value="#1D4ED8"/>
                                                                <Setter TargetName="Bd"
                                                                        Property="RenderTransform">
                                                                        <Setter.Value>
                                                                                <ScaleTransform ScaleX="0.97"
                                                                                                ScaleY="0.97"/>
                                                                        </Setter.Value>
                                                                </Setter>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Animated Cursor Style -->
                <Style x:Key="AnimatedCursor"
                       TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="|"/>
                        <Setter Property="FontSize"
                                Value="28"/>
                        <Setter Property="Foreground"
                                Value="#3B82F6"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                        <Style.Triggers>
                                <Trigger Property="IsVisible"
                                         Value="True">
                                        <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        From="1"
                                                                        To="0"
                                                                        Duration="0:0:0.8"
                                                                        AutoReverse="True"/>
                                                        </Storyboard>
                                                </BeginStoryboard>
                                        </Trigger.EnterActions>
                                </Trigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>

        <Border Background="White"
                CornerRadius="30"
                Effect="{StaticResource WindowShadow}">
                <Grid>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Gradient Background -->
                        <Border Grid.Row="0"
                                CornerRadius="30,30,0,0">
                                <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                             EndPoint="1,1">
                                                <GradientStop Color="#2563EB"
                                                              Offset="0"/>
                                                <GradientStop Color="#1D4ED8"
                                                              Offset="0.5"/>
                                                <GradientStop Color="#1E3A8A"
                                                              Offset="1"/>
                                        </LinearGradientBrush>
                                </Border.Background>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Row="0"
                                Content="✕"
                                HorizontalAlignment="Right"
                                Margin="0,16,16,0"
                                Width="40"
                                Height="40"
                                FontSize="18"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="CancelBtn_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Opacity="0.8">
                                <Button.Triggers>
                                        <EventTrigger RoutedEvent="Button.MouseEnter">
                                                <BeginStoryboard>
                                                        <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="1"
                                                                                 Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Button.MouseLeave">
                                                <BeginStoryboard>
                                                        <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0.8"
                                                                                 Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                </BeginStoryboard>
                                        </EventTrigger>
                                </Button.Triggers>
                        </Button>

                        <!-- Title -->
                        <TextBlock Grid.Row="0"
                                   Text="📱 Утасны дугаараа оруулах"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,20"/>

                        <!-- Main Content -->
                        <Grid Grid.Row="1"
                              Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="400"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="1"
                                        Background="White"
                                        CornerRadius="20"
                                        Margin="0,0,0,32"
                                        Padding="24">
                                        <StackPanel>

                                                <!-- Display Area -->
                                                <Border Background="#F8FAFC"
                                                        CornerRadius="16"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="2"
                                                        Padding="16,0"
                                                        Height="80"
                                                        Margin="0,0,0,28">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="TxtDisplay"
                                                                           Grid.Column="0"
                                                                           FontSize="32"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#0F172A"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                                                                           FontFamily="Consolas, Courier New, monospace">
                                                                        <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground"
                                                                                                Value="#0F172A"/>
                                                                                        <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Input.Length}"
                                                                                                             Value="0">
                                                                                                        <Setter Property="Foreground"
                                                                                                                Value="#94A3B8"/>
                                                                                                        <Setter Property="Text"
                                                                                                                Value="Enter phone number..."/>
                                                                                                </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                </Style>
                                                                        </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1"
                                                                           Style="{StaticResource AnimatedCursor}"
                                                                           Visibility="{Binding Input, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                        </Grid>
                                                </Border>

                                                <!-- Numpad Grid -->
                                                <Grid x:Name="NumPadGrid"
                                                      SizeChanged="NumPadGrid_SizeChanged"
                                                      Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 1 -->
                                                        <Button Grid.Row="0"
                                                                Grid.Column="0"
                                                                Content="1"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="1"/>
                                                        <Button Grid.Row="0"
                                                                Grid.Column="1"
                                                                Content="2"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="2"/>
                                                        <Button Grid.Row="0"
                                                                Grid.Column="2"
                                                                Content="3"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="3"/>

                                                        <!-- Row 2 -->
                                                        <Button Grid.Row="1"
                                                                Grid.Column="0"
                                                                Content="4"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="4"/>
                                                        <Button Grid.Row="1"
                                                                Grid.Column="1"
                                                                Content="5"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="5"/>
                                                        <Button Grid.Row="1"
                                                                Grid.Column="2"
                                                                Content="6"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="6"/>

                                                        <!-- Row 3 -->
                                                        <Button Grid.Row="2"
                                                                Grid.Column="0"
                                                                Content="7"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="7"/>
                                                        <Button Grid.Row="2"
                                                                Grid.Column="1"
                                                                Content="8"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="8"/>
                                                        <Button Grid.Row="2"
                                                                Grid.Column="2"
                                                                Content="9"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="9"/>

                                                        <!-- Row 4 -->
                                                        <Button Grid.Row="3"
                                                                Grid.Column="0"
                                                                Content="0"
                                                                Style="{StaticResource NumPadButtonStyle}"
                                                                Command="{Binding DigitCommand}"
                                                                CommandParameter="0"/>
                                                        <Button Grid.Row="3"
                                                                Grid.Column="1"
                                                                Content="⌫"
                                                                Style="{StaticResource ClearButtonStyle}"
                                                                Command="{Binding BackspaceCommand}"/>
                                                        <Button Grid.Row="3"
                                                                Grid.Column="2"
                                                                Content="✓ OK"
                                                                Style="{StaticResource OkButtonStyle}"
                                                                Command="{Binding OkCommand}"/>
                                                </Grid>

                                                <!-- Info Text -->
                                                <TextBlock Text="Enter 8-digit phone number"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0">
                                                        <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Input.Length}"
                                                                                             Value="0">
                                                                                        <Setter Property="Visibility"
                                                                                                Value="Visible"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Input.Length}"
                                                                                             Value="8">
                                                                                        <Setter Property="Visibility"
                                                                                                Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </TextBlock.Style>
                                                </TextBlock>
                                        </StackPanel>
                                </Border>
                        </Grid>
                </Grid>
        </Border>
</Window>