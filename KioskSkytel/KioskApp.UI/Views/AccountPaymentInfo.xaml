<Window x:Class="KioskSkytel.KioskApp.UI.Views.AccountPaymentInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaymentWindow"
        Width="900"
        Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

        <Window.Resources>

                <!-- Payment Option Card Button Style -->
                <Style x:Key="PaymentCardStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                Value="200"/>
                        <Setter Property="Height"
                                Value="120"/>
                        <Setter Property="Margin"
                                Value="12"/>
                        <Setter Property="FontSize"
                                Value="16"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Foreground"
                                Value="#1A3A8F"/>
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="BorderBrush"
                                Value="#C8D4F0"/>
                        <Setter Property="BorderThickness"
                                Value="2"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="14">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#EEF2FF"/>
                                                                <Setter Property="BorderBrush"
                                                                        Value="#3A6EE8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#D8E2FF"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Back Button Style -->
                <Style x:Key="BackButtonStyle"
                       TargetType="Button">
                        <Setter Property="Height"
                                Value="44"/>
                        <Setter Property="Padding"
                                Value="24,0"/>
                        <Setter Property="FontSize"
                                Value="15"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#1A3A8F"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="22"
                                                        Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="‹ "
                                                                           FontSize="20"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#1A3A8F"/>
                                                                <TextBlock Text="{TemplateBinding Content}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="#1A3A8F"/>
                                                        </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#EEF2FF"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- Field Label Style -->
                <Style x:Key="FieldLabelStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="13"/>
                        <Setter Property="Foreground"
                                Value="#555555"/>
                        <Setter Property="Margin"
                                Value="0,0,0,2"/>
                </Style>

                <!-- Field Value Style -->
                <Style x:Key="FieldValueStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="16"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Foreground"
                                Value="#1A3A8F"/>
                </Style>

                <!-- Info Row Border -->
                <Style x:Key="InfoRowStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="#F0F4FF"/>
                        <Setter Property="CornerRadius"
                                Value="8"/>
                        <Setter Property="Padding"
                                Value="14,10"/>
                        <Setter Property="Margin"
                                Value="0,0,0,10"/>
                </Style>

        </Window.Resources>

        <!-- Outer shadow border -->
        <Border Margin="16"
                Background="#F0F4FA"
                CornerRadius="18">
                <Border.Effect>
                        <DropShadowEffect BlurRadius="28"
                                          ShadowDepth="4"
                                          Opacity="0.16"
                                          Color="#000000"/>
                </Border.Effect>

                <Grid>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main Content -->
                        <Grid Grid.Row="0"
                              Margin="0">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- LEFT PANEL: Purchase Info -->
                                <Border Grid.Column="0"
                                        Background="White"
                                        CornerRadius="18,0,0,0"
                                        Padding="32,28,28,20">
                                        <StackPanel>
                                                <!-- Section Title -->
                                                <TextBlock Text="ТӨЛБӨРИЙН МЭДЭЭЛЭЛ"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#1A3A8F"
                                                           Margin="0,0,0,8"/>
                                                <Rectangle Height="1"
                                                           Fill="#DDDDDD"
                                                           Margin="0,0,0,18"/>

                                                <!-- Нэвтрэх нэр -->
                                                <Border Style="{StaticResource InfoRowStyle}">
                                                        <StackPanel>
                                                                <TextBlock Text="Дугаар:"
                                                                           Style="{StaticResource FieldLabelStyle}"/>
                                                                <TextBlock Text="{Binding AccountNumber}"
                                                                           Style="{StaticResource FieldValueStyle}"/>
                                                        </StackPanel>
                                                </Border>

                                                <!-- Сонгосон карт -->
                                                <Border Style="{StaticResource InfoRowStyle}">
                                                        <StackPanel>
                                                                <TextBlock Text="Багц"
                                                                           Style="{StaticResource FieldLabelStyle}"/>
                                                                <TextBlock Text="{Binding CardTitle}"
                                                                           Style="{StaticResource FieldValueStyle}"/>
                                                        </StackPanel>
                                                </Border>

                                                <!-- Төлөх дун -->
                                                <Border Style="{StaticResource InfoRowStyle}">
                                                        <StackPanel>
                                                                <TextBlock Text="Төлөх дүн:"
                                                                           Style="{StaticResource FieldLabelStyle}"/>
                                                                <TextBlock Text="{Binding PriceFormatted}"
                                                                           Style="{StaticResource FieldValueStyle}"/>
                                                        </StackPanel>
                                                </Border>

                                                <!-- Баримтын төрөл -->
                                                <Border Style="{StaticResource InfoRowStyle}">
                                                        <StackPanel>
                                                                <TextBlock Text="Баримтын төрөл:"
                                                                           Style="{StaticResource FieldLabelStyle}"/>
                                                                <TextBlock Text="Хувь хүн"
                                                                           Style="{StaticResource FieldValueStyle}"/>
                                                        </StackPanel>
                                                </Border>
                                        </StackPanel>
                                </Border>

                                <!-- Divider -->
                                <Rectangle Grid.Column="1"
                                           Fill="#DDDDDD"/>

                                <!-- RIGHT PANEL: Payment Method -->
                                <Border Grid.Column="2"
                                        Background="White"
                                        CornerRadius="0,18,0,0"
                                        Padding="28,28,32,20">
                                        <StackPanel>
                                                <!-- Section Title -->
                                                <TextBlock Text="ТӨЛБӨРИЙН ХЭРЭГСЭЛ"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#1A3A8F"
                                                           Margin="0,0,0,8"/>
                                                <Rectangle Height="1"
                                                           Fill="#DDDDDD"
                                                           Margin="0,0,0,28"/>

                                                <!-- Payment Options -->
                                                <WrapPanel HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">

                                                        <!-- Bank Card -->
                                                        <Button Style="{StaticResource PaymentCardStyle}"
                                                                Click="BankCard_Click">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                        <!-- Credit card icon -->
                                                                        <Viewbox Width="40"
                                                                                 Height="40"
                                                                                 Margin="0,0,0,8">
                                                                                <Canvas Width="24"
                                                                                        Height="24">
                                                                                        <Path Data="M20,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4M20,18H4V12H20V18M20,8H4V6H20V8Z"
                                                                                              Fill="#1A3A8F"/>
                                                                                </Canvas>
                                                                        </Viewbox>
                                                                        <TextBlock Text="БАНКНЫ КАРТ"
                                                                                   FontSize="14"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#1A3A8F"
                                                                                   HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                        </Button>

                                                        <!-- QPay -->
                                                        <Button Style="{StaticResource PaymentCardStyle}"
                                                                Click="QPay_Click">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                        <!-- QR icon -->
                                                                        <Viewbox Width="40"
                                                                                 Height="40"
                                                                                 Margin="0,0,0,8">
                                                                                <Canvas Width="24"
                                                                                        Height="24">
                                                                                        <Path Data="M3,11H5V13H3V11M11,5H13V9H11V5M9,11H13V15H11V13H9V11M15,11H17V13H19V11H21V13H19V15H21V19H19V21H17V19H15V21H13V17H15V15H17V13H15V11M19,19V15H17V19H19M15,3H21V9H15V3M17,5V7H19V5H17M3,3H9V9H3V3M5,5V7H7V5H5M3,15H9V21H3V15M5,17V19H7V17H5Z"
                                                                                              Fill="#1A3A8F"/>
                                                                                </Canvas>
                                                                        </Viewbox>
                                                                        <TextBlock Text="QPAY"
                                                                                   FontSize="14"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#1A3A8F"
                                                                                   HorizontalAlignment="Center"/>
                                                                </StackPanel>
                                                        </Button>

                                                </WrapPanel>
                                        </StackPanel>
                                </Border>
                        </Grid>

                        <!-- Bottom Bar -->
                        <Border Grid.Row="1"
                                Background="#E8EDF8"
                                CornerRadius="0,0,18,18"
                                Padding="24,12">
                                <Grid>
                                        <Button Content="Буцах"
                                                Style="{StaticResource BackButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="CloseBtn_Click"/>
                                </Grid>
                        </Border>

                </Grid>
        </Border>
</Window>
