<Window x:Class="KioskSkytel.KioskApp.UI.Views.AccountInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight"
        Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- Close circle button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="White"
                                CornerRadius="22"
                                BorderBrush="#1565C0"
                                BorderThickness="2">
                            <TextBlock Text="✕"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1565C0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Continue pill button -->
        <Style x:Key="ContinueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Outer container: modal + close button overlaid -->
        <Grid Width="400"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <!-- Modal card -->
            <Border Background="White"
                    CornerRadius="24"
                    Margin="0,22,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.20"
                                      BlurRadius="40"
                                      ShadowDepth="8"
                                      Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Fields -->
                        <RowDefinition Height="Auto"/>
                        <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- ── FIELDS ── -->
                    <StackPanel Grid.Row="0"
                                Margin="28,36,28,20">

                        <!-- Дугаар -->
                        <Border Background="#F8FAFF"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Дугаар"
                                               FontSize="12"
                                               Foreground="#94A3B8"
                                               FontWeight="Medium"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding AccountNumber}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#1565C0"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1"
                                         Width="8" Height="8"
                                         Fill="#1565C0"
                                         Opacity="0.25"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Дугаарын багц -->
                        <Border Background="#F8FAFF"
                                CornerRadius="12"
                                Padding="16,14"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Дугаарын багц"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontWeight="Medium"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding BundleName}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#1565C0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Хэрэглэгчийн нэр -->
                        <Border Background="#F8FAFF"
                                CornerRadius="12"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="Хэрэглэгчийн нэр"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           FontWeight="Medium"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding FullName}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#0D1B2A"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── FOOTER ── -->
                    <Border Grid.Row="1"
                            BorderBrush="#F1F5F9"
                            BorderThickness="0,1,0,0"
                            Padding="28,16,28,24">
                        <Button Style="{StaticResource ContinueButtonStyle}"
                                HorizontalAlignment="Right"
                                Click="ContinueBtnClick"
                                Padding="28,0">
                            <TextBlock Text="Үргэлжлүүлэх"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Close button — overlaid on top-right corner of card -->
            <Button Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Click="CancelBtn_Click"/>
        </Grid>
    </Grid>
</Window>
