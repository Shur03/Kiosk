<Window x:Class="KioskSkytel.KioskApp.UI.Views.AccountInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KioskSkytel.KioskApp.UI.Views"
        mc:Ignorable="d"
        Title="AccountInfo"
        Height="350"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Dimmed overlay background -->
        <Rectangle Fill="#80000000"/>

        <!-- Modal card -->
        <Border Background="White"
                CornerRadius="12"
                Width="420"
                Padding="32,28,32,32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  Opacity="0.18"
                                  BlurRadius="32"
                                  ShadowDepth="4"
                                  Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Row 0: Header -->
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header row: title + close button -->
                <Grid Grid.Row="0">
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="32"
                            Height="32"
                            Background="White"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="#F0F0F0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="✕"
                                   FontSize="13"
                                   Foreground="#444444"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Spacer -->
                <Grid Grid.Row="1"/>

                <!-- Row 2: Данс / Account -->
                <StackPanel Grid.Row="2"
                        Margin="0,0,0,14">
                    <TextBlock Text="Дугаар"
                               FontSize="15"
                               Foreground="#888888"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AccountNumber}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="MediumBlue"
                               TextWrapping="Wrap"/>
                    <Rectangle Fill="#E8E8E8"
                               Height="1"
                               Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Row 3: Дугаарын багц -->
                <StackPanel Grid.Row="3"
                        Margin="0,0,0,14">
                    <TextBlock Text="Дугаарын багц"
                               FontSize="15"
                               Foreground="#888888"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding BundleName}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="MediumBlue"
                               TextWrapping="Wrap"/>
                    <Rectangle Fill="#E8E8E8"
                               Height="1"
                               Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Row 4: Хэрэглэгчийн нэр -->
                <StackPanel Grid.Row="4"
                        Margin="0,0,0,14">
                    <TextBlock Text="Хэрэглэгчийн нэр"
                               FontSize="15"
                               Foreground="#888888"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding FullName}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="MediumBlue"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Spacer before buttons -->
                <Grid Grid.Row="5"/>

                <!-- Row 6: Buttons with rounded corners -->
                <Grid Grid.Row="6">
                    <Button Content="Буцах"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="20,10"
                            Background="Transparent"
                            Foreground="MediumBlue"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            Width="178"
                            Height="37">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Үргэлжлүүлэх"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="20,10"
                            Background="MediumBlue"
                            Foreground="White"
                            BorderBrush="#007ACC"
                            BorderThickness="1"
                            Cursor="Hand"
                            Margin="202,0,0,0"
                            Width="154"
                            Height="37">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>