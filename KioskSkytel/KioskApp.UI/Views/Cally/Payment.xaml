<Window x:Class="KioskSkytel.KioskApp.UI.Views.Cally.Payment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KioskSkytel.KioskApp.UI.Views.Cally"
        mc:Ignorable="d"
        Title="Payment"
        Height="650"
        Width="500"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="NumPadButtonStyle"
                TargetType="Button">
            <Setter Property="FontSize"
                    Value="24"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#0D1B2A"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="Margin"
                    Value="6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#EFF6FF"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearButtonStyle"
                TargetType="Button">
            <Setter Property="FontSize"
                    Value="24"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#DC2626"/>
            <Setter Property="Background"
                    Value="#FEF2F2"/>
            <Setter Property="Margin"
                    Value="6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                BorderBrush="#FECACA"
                                BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#FEE2E2"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#FECACA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OkButtonStyle"
                TargetType="Button">
            <Setter Property="FontSize"
                    Value="24"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="Background"
                    Value="#1565C0"/>
            <Setter Property="Margin"
                    Value="6"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White"
            CornerRadius="25"
            BorderBrush="#E2E8F0"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="Гэрээний дугаар оруулна уу"
               FontSize="22"
               FontFamily="Segoe UI"
               FontWeight="Bold"
               Foreground="#1A1A2E"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseButtonStyle}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="CloseButton_Click"/>
            </Grid>

            

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="20"
                        Margin="0,24,0,32"
                        Padding="24">
                    <StackPanel>

                        <Border Background="#F8FAFC"
                                CornerRadius="12"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1.5"
                                Padding="16,0"
                                Height="64"
                                Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDisplay"
                                           Grid.Column="0"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="#0D1B2A"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="|"
                                           FontSize="28"
                                           Foreground="#1565C0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="NumPadGrid"
                              SizeChanged="NumPadGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Content="1"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="1"/>
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    Content="2"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="2"/>
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Content="3"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="3"/>

                            <Button Grid.Row="1"
                                    Grid.Column="0"
                                    Content="4"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="4"/>
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Content="5"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="5"/>
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Content="6"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="6"/>

                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Content="7"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="7"/>
                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    Content="8"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="8"/>
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Content="9"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="9"/>

                            <Button Grid.Row="3"
                                    Grid.Column="0"
                                    Content="0"
                                    Style="{StaticResource NumPadButtonStyle}"
                                    Click="NumBtn_Click"
                                    Tag="0"/>
                            <Button Grid.Row="3"
                                    Grid.Column="1"
                                    Content="⌫"
                                    Style="{StaticResource ClearButtonStyle}"
                                    Click="ClearBtn_Click"/>
                            <Button Grid.Row="3"
                                    Grid.Column="2"
                                    Content="OK"
                                    Style="{StaticResource OkButtonStyle}"
                                    Click="OkBtn_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>
