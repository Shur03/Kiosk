<UserControl x:Class="KioskSkytel.KioskApp.UI.Views.Skytel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KioskSkytel.KioskApp.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>

        <!-- HEADER -->

        <!-- MAIN GRID -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- CARD 1 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">
                <Grid Margin="20">

                    <StackPanel>
                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12"
                                HorizontalAlignment="Left">

                            <!-- ICON PLACEHOLDER -->
                            <TextBlock Text="📄"
                                       FontSize="26"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Шинэ дугаар"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Урьдчилсан болон дараа төлбөрт үйлчилгээний шинэ дугаар"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>


                    </StackPanel>

                </Grid>
            </Border>

            <!-- CARD 2 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200*"/>
                        <ColumnDefinition Width="21*"/>
                        <ColumnDefinition Width="59*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="3">
                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12">

                            <TextBlock Text="⚡"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Нэгж авах"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Урьдчилсан төлбөрт үйлчилгээний цэнэглэгч картууд"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>


                    </StackPanel>

                </Grid>
            </Border>

            <!-- CARD 3 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">

                <Grid Margin="20">
                    <StackPanel>

                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12">
                            <TextBlock Text="💳"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Төлбөр төлөх"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Хүссэн газраасаа, хүссэн цагтаа төлбөрөө төлөх боломж"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>



                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD 4 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Margin="20"
                    CornerRadius="18"
                    Background="White"
                    Width="320" Height="260">

                <Grid Margin="20">
                    <StackPanel>

                        <Border Width="60" Height="60"
                                Background="#F1F5F9"
                                CornerRadius="12">
                            <TextBlock Text="🔄"
                                       FontSize="26"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Сим сэргэх"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,15,0,0"/>

                        <TextBlock Text="Та GoSIM ашиглан хүссэн үедээ симээ сэргээж"
                                   FontSize="13"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>



                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
